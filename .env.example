# Ground API and PostgreSQL. Passwords and the signing secret come only from the environment.
# The password inside DATABASE_URL must be URL-safe: no spaces and no @ : / ? # characters.
# Pure-Python driver: postgresql+pg8000://user:password@host:5432/artemia
POSTGRES_USER=artemia
POSTGRES_PASSWORD=
POSTGRES_DB=artemia
TOKEN_SECRET=

SEED_MIRA_EMAIL=mira-01@demo.artemia.local
SEED_MIRA_PASSWORD=123
SEED_ALEX_EMAIL=alex-02@demo.artemia.local
SEED_ALEX_PASSWORD=123
SEED_FLIGHT_DOC_EMAIL=flight-doc@demo.artemia.local
SEED_FLIGHT_DOC_PASSWORD=123

# Optional. When empty, the mission starts 14 days before the seed run and lasts 180 days.
SEED_MISSION_START_AT=

# Browser build. demo marks every screen as synthetic. The API URL is not a privilege.
VITE_ENVIRONMENT=demo
VITE_API_URL=http://localhost:8000
